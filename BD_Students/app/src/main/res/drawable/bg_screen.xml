<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/page_background" />

    <item
        android:width="270dp"
        android:height="270dp"
        android:gravity="top|end"
        android:right="-70dp"
        android:top="-90dp">
        <shape android:shape="oval">
            <solid android:color="#DCE7F4" />
        </shape>
    </item>

    <item
        android:width="190dp"
        android:height="190dp"
        android:gravity="top|start"
        android:left="-100dp"
        android:top="32dp">
        <shape android:shape="oval">
            <solid android:color="#F8FBFF" />
        </shape>
    </item>
</layer-list>
