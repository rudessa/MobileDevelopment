<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="130dp"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:gravity="center">

        <ImageView
            android:id="@+id/imageCapitalCloud"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_cloud_partial"
            app:tint="@color/accent_blue" />

        <TextView
            android:id="@+id/textCapitalTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/primary_blue"
            tools:text="12°C" />

        <TextView
            android:id="@+id/textCapitalName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/city_text"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Москва" />

        <TextView
            android:id="@+id/textCapitalCountry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            tools:text="RU" />

        <TextView
            android:id="@+id/textCapitalHumidity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            tools:text="💧 65%" />
    </LinearLayout>

</androidx.cardview.widget.CardView>